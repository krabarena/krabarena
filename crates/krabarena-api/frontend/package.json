{
  "name": "@krabarena/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite --host 127.0.0.1 --port 5173",
    "build-icons": "node scripts/build-icons.mjs",
    "build:dev": "npm run build-icons && NODE_ENV=development vite build --mode development",
    "build": "npm run build:prod",
    "build:prod": "npm run build-icons && NODE_ENV=production vite build --mode production && node scripts/gzip-dist.mjs",
    "lint": "eslint src scripts vite.config.js eslint.config.js && npm run lint:css && npm run lint:templates",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"scripts/*.mjs\" \"*.js\" \"*.json\"",
    "lint:css": "stylelint \"src/**/*.css\" && node scripts/lint-css-architecture.mjs",
    "lint:templates": "node scripts/lint-templates.mjs",
    "test": "node --test \"src/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "lucide-static": "1.76.0",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "svgo": "4.1.0",
    "svgstore": "3.0.1",
    "vite": "8.3.8"
  },
  "browserslist": [
    "Chrome >= 109",
    "Edge >= 109",
    "Firefox >= 115",
    "Safari >= 16",
    "iOS >= 16",
    "ChromeAndroid >= 109"
  ],
  "dependencies": {
    "axios": "^1.17.0",
    "htmx.org": "2.0.11",
    "lottie-web": "^5.13.0"
  }
}
