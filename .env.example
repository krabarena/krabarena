# Database (local Docker: pgvector/pgvector:pg16, see CONTRIBUTING.md)
DATABASE_URL=postgresql://krabarena:krabarena@127.0.0.1:5432/krabarena
SQLX_AUTO_MIGRATE=true

# API runtime
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
BLOB_STORE_URL=https://blob.vercel-storage.com
# Non-public store for claims' private artifacts (prod: gs://krabarena-artifacts-private).
# Unset in dev = falls back to BLOB_STORE_URL; unset in prod = private uploads refused.
PRIVATE_BLOB_STORE_URL=
JWT_SECRET=change-me-in-production
KRAB_DEV_LOG_LOGIN_CODES=1
TEST_AUTH_SECRET=letmein
RUST_LOG=info

# Frontend assets
# development: manifest helper may fall back to VITE_DEV_SERVER_URL.
# production: manifest lookup is strict and expects static/dist/.vite/manifest.json.
NODE_ENV=development
VITE_DEV_SERVER_URL=http://127.0.0.1:5173
STATIC_DIR=

# Bot protection — Google reCAPTCHA Enterprise (score-based) on voter email
# sign-in. All of the site key + project id + API key must be set to enable;
# any unset => captcha disabled: no widget, no verification, login works as-is
# (the local-dev default). Enterprise has no universal test keys, so local dev
# leaves these empty. In prod the site key is a public GitHub Actions variable
# and the API key a GitHub Actions secret injected by deploy.yml.
#   RECAPTCHA_SITE_KEY               public Enterprise (SCORE) key id
#   RECAPTCHA_ENTERPRISE_PROJECT_ID  GCP project owning the key + assessments
#   RECAPTCHA_ENTERPRISE_API_KEY     API key restricted to reCAPTCHA Enterprise
#   RECAPTCHA_SCORE_THRESHOLD        min risk score to accept (default 0.5)
RECAPTCHA_SITE_KEY=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_SCORE_THRESHOLD=

# Analytics
GA_MEASUREMENT_ID=
DISCORD_SUPPORT_INVITE_URL=https://discord.gg/K3zmyrqBSz
# Public source repo; renders a GitHub button in the header when set.
GITHUB_REPO_URL=

# Discord monitoring
DISCORD_MONITOR_ENABLED=false
DISCORD_MONITOR_BOT_TOKEN=
DISCORD_MONITOR_CHANNEL_ID=
# Shared secret for the private cron endpoints. Unset => those endpoints
# are dormant (404); set => callers must send it in the cron secret header.
CRON_SHARED_SECRET=

# LLM (Gemini) — shared app-wide (KrabReviewer, embeddings).
# Empty key => synthetic/dev mode where applicable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
