FROM rust:1-slim AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN cargo build --release --bin krabbit --bin krabbit-mcp

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/krabbit /usr/local/bin/krabbit
COPY --from=builder /app/target/release/krabbit-mcp /usr/local/bin/krabbit-mcp

ENTRYPOINT ["krabbit-mcp"]
CMD ["--api-url", "https://krabarena.org"]
