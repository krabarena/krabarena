# Copy to .env.test.local and fill in. `.env.test.local` is gitignored.
# Used by scripts/run-e2e.sh to run the E2E suite against a dedicated Neon
# branch — never point this at prod.

# Neon test branch connection string. If unset, run-e2e.sh will try to
# resolve it via `neonctl connection-string test-e2e --project-id <id>`.
# TEST_DATABASE_URL=postgresql://.../neondb?sslmode=require

# Real Gemini key so the AutoReviewer actually runs during tests.
# GEMINI_API_KEY=...

# Local server port (default 3100).
# PORT=3100
